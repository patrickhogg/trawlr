{
  "name": "trawlr",
  "private": true,
  "version": "1.3.0",
  "description": "Open-source desktop web crawler and link auditor. Find broken links, track redirects, and audit SEO meta tags.",
  "author": {
    "name": "Patrick Hogg",
    "email": "phogg@professionalplanets.com"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:linux": "vite build && electron-builder --linux",
    "build:flatpak": "vite build && electron-builder --linux flatpak",
    "preview": "vite preview"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "p-queue": "^9.3.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.11"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.trawlr.app",
    "productName": "Trawlr",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Trawlr-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "Trawlr-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "flatpak"
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "trawlr"
        }
      },
      "category": "Development",
      "icon": "build/icons",
      "synopsis": "Desktop web crawler and link auditor",
      "artifactName": "Trawlr-${version}-linux-${arch}.${ext}"
    },
    "flatpak": {
      "runtimeVersion": "25.08",
      "baseVersion": "25.08",
      "useWaylandFlags": true,
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--filesystem=home",
        "--talk-name=org.freedesktop.Notifications"
      ]
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
